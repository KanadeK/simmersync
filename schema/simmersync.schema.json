{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KanadeK/simmersync/raw/main/schema/simmersync.schema.json",
  "title": "SimmerSync plan",
  "description": "A deterministic, resource-aware plan for coordinating multiple dishes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "resources", "dishes"],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "examples": ["Europe/London", "Asia/Tokyo"]
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attentionResource": {
          "$ref": "#/$defs/id"
        },
        "horizonMinutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 10080,
          "default": 1440
        }
      }
    },
    "dishes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/dish"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity"],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "dish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "serveOffset": {
          "type": "integer",
          "minimum": -1440,
          "maximum": 1440,
          "default": 0
        },
        "maxHold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440,
          "default": 15
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "duration", "mode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "mode": {
          "enum": ["active", "passive"]
        },
        "resources": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
